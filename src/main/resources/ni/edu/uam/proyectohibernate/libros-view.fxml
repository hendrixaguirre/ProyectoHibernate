<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="520.0" prefWidth="673.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectohibernate.controller.LibroController">
   <children>
      <Label layoutX="29.0" layoutY="23.0" text="Registro de libros">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <GridPane layoutX="29.0" layoutY="80.0" prefHeight="120.0" prefWidth="253.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="161.0" minWidth="10.0" prefWidth="42.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="284.0" minWidth="10.0" prefWidth="211.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Título:" />
            <Label text="Autor:" GridPane.rowIndex="1" />
            <Label text="Año:" GridPane.rowIndex="2" />
            <Label text="Precio:" GridPane.rowIndex="3" />
            <TextField fx:id="txtTitulo" promptText="Título del libro" GridPane.columnIndex="1" />
            <TextField fx:id="txtAutor" promptText="Autor del libro" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtAño" promptText="Año de publicación" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecio" promptText="Precio del libro" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox layoutX="29.0" layoutY="208.0" prefHeight="30.0" prefWidth="200.0" spacing="15.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar Libro" />
            <Button fx:id="btnCargar" mnemonicParsing="false" onAction="#cargarLibros" text="Cargar Libros" />
         </children>
      </HBox>
      <TableView fx:id="tblLibros" layoutX="29.0" layoutY="252.0" prefHeight="251.0" prefWidth="615.0">
        <columns>
          <TableColumn fx:id="colID" prefWidth="51.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="171.0" text="Título" />
            <TableColumn fx:id="colAutor" prefWidth="181.0" text="Autor" />
            <TableColumn fx:id="colAño" prefWidth="111.0" text="Año Publicación" />
            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
        </columns>
      </TableView>
      <Separator layoutX="4.0" layoutY="68.0" prefHeight="4.0" prefWidth="667.0" />
   </children>
</AnchorPane>
