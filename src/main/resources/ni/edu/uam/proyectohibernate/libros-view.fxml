<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="545.0" prefWidth="816.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectohibernate.controller.LibroController">
   <children>
      <Label layoutX="29.0" layoutY="23.0" text="Registro de libros">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <GridPane layoutX="29.0" layoutY="79.0" prefHeight="148.0" prefWidth="294.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="161.0" minWidth="10.0" prefWidth="59.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="284.0" minWidth="10.0" prefWidth="235.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Título:" />
            <Label text="Autor:" GridPane.rowIndex="1" />
            <Label text="Año:" GridPane.rowIndex="2" />
            <Label text="Precio:" GridPane.rowIndex="3" />
            <TextField fx:id="txtTitulo" promptText="Título del libro" GridPane.columnIndex="1" />
            <TextField fx:id="txtAutor" promptText="Autor del libro" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtAnio" promptText="Año de publicación" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecio" promptText="Precio del libro" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Categoría:" GridPane.rowIndex="4" />
            <ComboBox fx:id="cmbCategoria" prefHeight="25.0" prefWidth="197.0" promptText="Seleccione la categoría" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      <HBox layoutX="29.0" layoutY="236.0" prefHeight="30.0" prefWidth="524.0" spacing="15.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar Libro" />
            <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#modificarLibro" text="Modificar libro" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarLibro" text="Eliminar libro" />
            <Button fx:id="btnCargar" mnemonicParsing="false" onAction="#cargarLibros" text="Cargar Libros" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar campos" />
         </children>
      </HBox>
      <TableView fx:id="tblLibros" layoutX="29.0" layoutY="272.0" prefHeight="251.0" prefWidth="756.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="51.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="171.0" text="Título" />
            <TableColumn fx:id="colAutor" prefWidth="181.0" text="Autor" />
            <TableColumn fx:id="colAnio" prefWidth="111.0" text="Año Publicación" />
            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
            <TableColumn fx:id="colCategoria" prefWidth="141.0" text="Categoría" />
        </columns>
      </TableView>
      <Separator layoutX="4.0" layoutY="68.0" prefHeight="4.0" prefWidth="667.0" />
   </children>
</AnchorPane>
